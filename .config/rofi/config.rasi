configuration {
    modi: "drun,run";
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 12";
    display-drun: " ";
    drun-display-format: "{name}";
}

@import "colors.rasi"

window {
    width: 40%;
    padding: 24px;
    border-radius: 16px;
    background-color: @background;
    border: 1px solid;
    border-color: rgba(255, 255, 255, 0.30);
}

mainbox {
    background-color: transparent;
    border: 0px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @background-alt;
    border-radius: 12px;
    padding: 14px;
    spacing: 12px;
}

prompt {
    background-color: transparent;
    text-color: @primary;
    font: "JetBrainsMono Nerd Font 14";
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Buscar...";
    placeholder-color: @foreground;
}

listview {
    background-color: transparent;
    margin: 24px 0 0 0;
    lines: 7;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
    border: 0px;
}

element {
    padding: 12px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

/* Force normal and alternate states to be transparent so they don't use the default alternating colors */
element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @foreground;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @primary;
}

element selected.normal,
element selected.active {
    background-color: @primary;
    text-color: @on-primary;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 28px;
    margin: 0 16px 0 0;
}
