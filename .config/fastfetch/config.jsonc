{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/zero.txt",
    "type": "file",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "magenta", "at": "white", "host": "magenta" } },
    "separator",
    { "type": "os", "key": " OS", "keyColor": "blue" },
    { "type": "host", "key": " HW", "keyColor": "blue" },
    { "type": "kernel", "key": " Kernel", "keyColor": "blue" },
    { "type": "uptime", "key": " Uptime", "keyColor": "blue" },
    { "type": "packages", "key": " Packages", "keyColor": "blue" },
    { "type": "wm", "key": " WM", "keyColor": "blue" },
    { "type": "terminal", "key": " Terminal", "keyColor": "blue" },
    "separator",
    { "type": "cpu", "key": " CPU", "keyColor": "cyan" },
    { "type": "gpu", "key": " GPU", "keyColor": "cyan" },
    { "type": "memory", "key": " RAM", "keyColor": "cyan" },
    "break",
    "colors"
  ]
}
