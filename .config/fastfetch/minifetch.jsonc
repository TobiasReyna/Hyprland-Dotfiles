{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch_small",
    "padding": { "top": 1, "left": 1, "right": 2 },
    "color": { "1": "cyan" }
  },
  "display": {
    "separator": "    ",
    "color": { "keys": "cyan" }
  },
  "modules": [
    "break",
    { "type": "title", "color": { "user": "cyan", "at": "white", "host": "cyan" } },
    { "type": "os", "key": " ", "keyColor": "blue", "format": "{2}" },
    { "type": "kernel", "key": " ", "keyColor": "blue", "format": "{1} {2}" },
    { "type": "wm", "key": " ", "keyColor": "blue" },
    { "type": "cpu", "key": " ", "keyColor": "magenta", "format": "{1}" },
    { "type": "gpu", "key": " ", "keyColor": "magenta", "format": "{2}", "hideType": "integrated" },
    { "type": "memory", "key": " ", "keyColor": "magenta" },
    "break"
  ]
}
